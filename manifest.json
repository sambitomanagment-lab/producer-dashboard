{
  "manifest_version": 3,
  "name": "ProducerDashboard",
  "version": "1.0.0",
  "description": "A private new tab page for music producers: your sites and tools one click away, no account needed.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "search"],
  "chrome_url_overrides": {
    "newtab": "index.html"
  }
}
